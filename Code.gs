function processRegister(nama, email, password, role) {
  try {
    var SPREADSHEET_ID = "1qWZXSZmIe-xUMb_ap_tLzTHjSBhW3KaqaHF8iSa61wg";
    var ss = SpreadsheetApp.openById(SPREADSHEET_ID);
    var sheet = ss.getSheetByName("Users");
    
    if (!sheet) {
      sheet = ss.insertSheet("Users");
      sheet.appendRow(["Timestamp", "Nama Lengkap", "Email / Username", "Kata Sandi", "Peran Akses", "Status"]);
      sheet.getRange(1, 1, 1, 6).setFontWeight("bold").setBackground("#f3f4f6");
    }
    
    var data = sheet.getDataRange().getValues();
    for (var i = 1; i < data.length; i++) {
      if (String(data[i][2]).toLowerCase() === String(email).toLowerCase()) {
        return { status: "error", message: "Email / Username tersebut sudah terdaftar!" };
      }
    }
    
    sheet.appendRow([new Date(), nama, email, password, role, "ACTIVE"]);
    return { status: "success", message: "Pendaftaran berhasil! Silakan masuk." };
  } catch (err) {
    return { status: "error", message: err.toString() };
  }
}

function processLogin(email, password) {
  try {
    var SPREADSHEET_ID = "1qWZXSZmIe-xUMb_ap_tLzTHjSBhW3KaqaHF8iSa61wg";
    var ss = SpreadsheetApp.openById(SPREADSHEET_ID);
    var sheet = ss.getSheetByName("Users");
    
    if (!sheet) {
      sheet = ss.insertSheet("Users");
      sheet.appendRow(["Timestamp", "Nama Lengkap", "Email / Username", "Kata Sandi", "Peran Akses", "Status"]);
      sheet.appendRow([new Date(), "Administrator PFTV", "admin@smkn1gs.sch.id", "guru-pftv-2026", "teacher", "ACTIVE"]);
      sheet = ss.getSheetByName("Users");
    }
    
    var data = sheet.getDataRange().getValues();
    for (var i = 1; i < data.length; i++) {
      var dbEmail = String(data[i][2]).trim();
      var dbPassword = String(data[i][3]).trim();
      var dbRole = String(data[i][4]).trim().toLowerCase();
      var dbStatus = String(data[i][5]).trim();
      
      if (dbEmail.toLowerCase() === String(email).trim().toLowerCase() && dbPassword === password) {
        if (dbStatus !== "ACTIVE") {
          return { status: "error", message: "Akun ditangguhkan." };
        }
        
        // Mengirimkan kredensial sukses ke frontend agar disimpan di sessionStorage tab aktif
        return { 
          status: "success", 
          email: dbEmail, 
          role: dbRole 
        };
      }
    }
    
    return { status: "error", message: "Email atau kata sandi salah!" };
  } catch (err) {
    return { status: "error", message: "Gagal login: " + err.toString() };
  }
}

function getStandardsData(tahunAjaran) {
  try {
    var results = [];
    var keysToCheck = [
      "1.1","1.2","1.3","1.4","2.1","2.2","2.3","2.4","2.5","2.6","2.7","2.8",
      "3.1","3.2","3.3","3.4","3.5","4.1","4.2","4.3","4.4","4.5","5.1","5.2",
      "6.1","6.2","6.3","6.4","6.5","6.6","6.7","7.1","7.2","7.3","8.1","8.2",
      "8.3","8.4","9.1","9.2","9.3","9.4","9.5","9.6","9.7","9.8","9.9","9.10"
    ];
    var currentFolders = ARCHIVE_FOLDERS[tahunAjaran] || ARCHIVE_FOLDERS["TA_2025_2026"];
    
    keysToCheck.forEach(function(key) {
      var folderId = currentFolders[key];
      var count = 0;
      var folderUrl = "https://drive.google.com";
      if (folderId) {
        try {
          var folder = DriveApp.getFolderById(folderId);
          folderUrl = folder.getUrl();
          var files = folder.getFiles();
          while (files.hasNext()) { files.next(); count++; }
        } catch (e) {}
      }
      results.push({ id: key, name: getSubStandardName(key), status: count > 0 ? "complete" : "incomplete", count: count, folderUrl: folderUrl });
    });
    return { "status": "success", "tahunAjaran": tahunAjaran, "standards": results };
  } catch (err) {
    return { "status": "error", "message": err.toString() };
  }
}

