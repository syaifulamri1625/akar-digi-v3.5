var NOTIF_EMAIL_TARGET = "nesatpictures@smkn1gunungsindur.sch.id";

function sendNotificationEmail(subject, htmlBodyContent) {
  try {
    GmailApp.sendEmail(
      NOTIF_EMAIL_TARGET, 
      subject, 
      "Sistem AKAR-DIGI v3.5 - Silakan buka menggunakan perangkat yang mendukung tampilan HTML.", 
      { htmlBody: htmlBodyContent, name: "Sistem AKAR-DIGI v3.5" }
    );
    return true;
  } catch (err) {
    return false;
  }
}

