function generatePDFReport(periodeType, tahunAjaran) {
  var ssId = "1qWZXSZmIe-xUMb_ap_tLzTHjSBhW3KaqaHF8iSa61wg";
  var docId = "1TrfXEimQgOuLJ8F9le5rb5mq-LK7aHjFyMrxVTtfFyY";
  var folderId = "1CGpAGe9JK4WjgGtLyksfCJahLBF28Cbr";
  
  var sheet = SpreadsheetApp.openById(ssId).getSheetByName("LogUpload");
  var rows = sheet ? sheet.getDataRange().getValues() : [];
  var total = 0, content = "", count = 1;
  
  for (var i = 1; i < rows.length; i++) {
    if ((rows[i][6] || "TA_2025_2026") === tahunAjaran) {
      content += count + ". [" + new Date(rows[i][0]).toLocaleDateString("id-ID") + "] (" + rows[i][2] + ") " + rows[i][1] + " - OK\n";
      total++; count++;
    }
  }
  
  var copy = DriveApp.getFileById(docId).makeCopy("Lap_" + tahunAjaran + "_" + new Date().getTime());
  var doc = DocumentApp.openById(copy.getId());
  var body = doc.getBody();
  body.replaceText("{{PERIODE_LAPORAN}}", periodeType.toUpperCase() + " (" + tahunAjaran.replace("_", " ") + ")");
  body.replaceText("{{TANGGAL_CETAK}}", new Date().toLocaleDateString("id-ID", {dateStyle: 'full'}));
  body.replaceText("{{TOTAL_DOKUMEN}}", total + " Berkas");
  body.replaceText("{{TABEL_DATA_LOG}}", content || "Tidak ada data.");
  doc.saveAndClose();
  
  var pdf = copy.getAs("application/pdf");
  var file = DriveApp.getFolderById(folderId).createFile(pdf);
  copy.setTrashed(true);
  return file.getUrl();
}